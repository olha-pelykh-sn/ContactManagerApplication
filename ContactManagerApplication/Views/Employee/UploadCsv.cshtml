@{
    ViewData["Title"] = "Import Employees from CSV";
}

<div class="container mt-4" style="max-width: 760px;">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="mb-0">Import Employees from CSV</h2>
        <a asp-controller="Employee" asp-action="GetAllEmployees" class="btn btn-outline-secondary btn-sm">
            &larr; Back to Employees
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="post"
                  asp-controller="Employee"
                  asp-action="UploadCsv"
                  enctype="multipart/form-data">

                <div class="mb-3">
                    <label for="csvFile" class="form-label fw-semibold">CSV File</label>
                    <input type="file" id="csvFile" name="csvFile"
                           class="form-control" accept=".csv" required />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Upload &amp; Import
                    </button>
                    <a asp-controller="Employee" asp-action="DownloadCsvTemplate"
                       class="btn btn-outline-secondary">
                        Download Sample CSV
                    </a>
                </div>
            </form>
        </div>
    </div>


</div>
