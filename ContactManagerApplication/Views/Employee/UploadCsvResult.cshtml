@using ContactManagerApplication.Models.ViewModel
@using ContactManagerApplication.Models.Domain
@model CsvImportResultVM
@{
    ViewData["Title"] = "CSV Import Result";
}

<div class="container mt-4" style="max-width: 900px;">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="mb-0">CSV Import Result</h2>
        <div class="d-flex gap-2">
            <a asp-controller="Employee" asp-action="UploadCsv" class="btn btn-outline-primary btn-sm">
                Upload Another File
            </a>
            <a asp-controller="Employee" asp-action="GetAllEmployees" class="btn btn-outline-secondary btn-sm">
                View Employees
            </a>
        </div>
    </div>

    <div class="d-flex align-items-baseline gap-2 mb-4">
        <span class="display-5 fw-bold @(Model.FailureCount == 0 ? "text-success" : (Model.SuccessCount == 0 ? "text-danger" : "text-warning"))">
            @Model.SuccessCount/@Model.TotalRows
        </span>
        <span class="text-muted fs-5">records imported</span>
        @if (Model.FailureCount > 0)
        {
            <span class="badge bg-danger ms-2 fs-6">@Model.FailureCount failed</span>
        }
    </div>

    @if (Model.ImportedEmployees.Count > 0)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <strong>Imported Records (@Model.ImportedEmployees.Count)</strong>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Birth Day</th>
                            <th>Is Married</th>
                            <th>Phone</th>
                            <th>Salary</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.ImportedEmployees)
                        {
                            <tr>
                                <td>@emp.Name</td>
                                <td>@emp.BirthDay?.ToString("dd/MM/yyyy")</td>
                                <td>@(emp.IsMarried == true ? "Yes" : emp.IsMarried == false ? "No" : "–")</td>
                                <td>@(string.IsNullOrEmpty(emp.Phone) ? "–" : emp.Phone)</td>
                                <td>@emp.Salary.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.Errors.Count > 0)
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Errors (@Model.Errors.Count)</strong>
                <small class="text-muted">Fix these rows and re-upload the corrected file.</small>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;">Row #</th>
                            <th>Error</th>
                            <th>Raw data</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var error in Model.Errors)
                        {
                            <tr class="table-danger">
                                <td class="text-center">
                                    @(error.RowNumber == 0 ? "–" : error.RowNumber.ToString())
                                </td>
                                <td>@error.ErrorMessage</td>
                                <td class="text-muted small font-monospace">
                                    @(string.IsNullOrEmpty(error.RawData) ? "–" : error.RawData)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
