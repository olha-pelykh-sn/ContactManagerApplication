@model ContactManagerApplication.Models.ViewModel.UpdateEmployeeVM
@using ContactManagerApplication.Validation
@{
    ViewData["Title"] = "Edit Employee";
    var today      = DateOnly.FromDateTime(DateTime.Today);
    var minBirthDay = today.AddYears(-BirthDayRangeAttribute.MaxAgeYears).ToString("yyyy-MM-dd");
    var maxBirthDay = today.AddYears(-BirthDayRangeAttribute.MinAgeYears).ToString("yyyy-MM-dd");
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h2>Edit Employee</h2>
            <hr />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    <h4 class="alert-heading">Error!</h4>
                    @if (ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
                    {
                        <ul>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    }
                </div>
            }

            <form asp-area="" asp-controller="Employee" asp-action="UpdateEmployee" method="post" class="needs-validation">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Name *</label>
                    <input type="text" asp-for="Name" class="form-control" placeholder="Enter employee name" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BirthDay" class="form-label">Date of Birth</label>
                    <input type="date" asp-for="BirthDay" class="form-control"
                           min="@minBirthDay" max="@maxBirthDay" />
                    <span asp-validation-for="BirthDay" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Is Married</label>
                    <div class="form-check">
                        <input type="radio" id="married_yes" asp-for="IsMarried" value="true" class="form-check-input" />
                        <label class="form-check-label" for="married_yes">Yes</label>
                    </div>
                    <div class="form-check">
                        <input type="radio" id="married_no" asp-for="IsMarried" value="false" class="form-check-input" />
                        <label class="form-check-label" for="married_no">No</label>
                    </div>
                    <span asp-validation-for="IsMarried" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label">Phone</label>
                    <input type="tel" asp-for="Phone" class="form-control" placeholder="Enter phone number" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Salary" class="form-label">Salary *</label>
                    <input type="number" asp-for="Salary" class="form-control" placeholder="Enter salary" step="0.01" min="0" max="9999999.99" />
                    <span asp-validation-for="Salary" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-area="" asp-controller="Employee" asp-action="GetAllEmployees" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
